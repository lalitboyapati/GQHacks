# Copy this file to .env in the same folder and fill in your credentials.
# .env is gitignored: never commit it.
WEBULL_APP_KEY=your_app_key
WEBULL_APP_SECRET=your_app_secret
WEBULL_API_ENDPOINT=api.webull.com
WEBULL_REGION_ID=us

# What to backtest
WEBULL_SYMBOLS=AAPL,TSLA
WEBULL_CATEGORY=US_STOCK
WEBULL_TIMESPAN=D
WEBULL_COUNT=1200
# Optional range, ISO 8601 with a timezone. Leave unset to take the most recent WEBULL_COUNT bars.
# WEBULL_FROMDATE=2022-01-03T09:30:00-05:00
# WEBULL_TODATE=2024-12-31T16:00:00-05:00

# Strategy: a file name in examples/strategies/, without .py
WEBULL_STRATEGY=dual_ma
# WEBULL_STRATEGY_PARAMS=short_period=10,long_period=30
#
# Item 2.02 / earnings options-impact strategy (Massive 8-K events):
# WEBULL_STRATEGY=item_202_options
# WEBULL_STRATEGY_PARAMS=hold_bars=5,min_gap_atr=0.5,mode=momentum,allow_short=true
# WEBULL_COUNT=1200

# Massive.com (formerly Polygon) — SEC 8-K Item 2.02 + optional Benzinga earnings
# MASSIVE_API_KEY=your_massive_api_key
# MASSIVE_EVENTS_CACHE=examples/data/item_202_events_sample.json
# MASSIVE_FILING_DATE_GTE=2023-01-01
# MASSIVE_FILING_DATE_LTE=2026-12-31

# Report and logging
WEBULL_VISUALIZE=true
# WEBULL_VISUALIZE_OUTPUT=backtest_report.html
# WEBULL_DISPLAY_TZ=America/New_York
# LOG_LEVEL=INFO
