# Shared credentials for ALL research tracks (never commit).
WEBULL_APP_KEY=your_app_key
WEBULL_APP_SECRET=your_app_secret
WEBULL_API_ENDPOINT=api.webull.com
WEBULL_REGION_ID=us

# Defaults (overridden by run.py --track / CLI / track .env)
WEBULL_SYMBOLS=AAPL
WEBULL_CATEGORY=US_STOCK
WEBULL_TIMESPAN=D
WEBULL_COUNT=1200

# Prefer a research track (see tracks/). Examples: item_202_results_ops
GQH_TRACK=item_202_results_ops
# Or a demo strategy under infrastructure/examples/strategies/
# WEBULL_STRATEGY=dual_ma
# WEBULL_STRATEGY_PARAMS=short_period=10,long_period=30

# Massive.com — one app key is enough for filings
# MASSIVE_APP_KEY=your_massive_app_key
# MASSIVE_EVENTS_CACHE=tracks/item_202_results_ops/data/item_202_events_high_vol.json
# MASSIVE_FILING_DATE_GTE=2023-01-01
# MASSIVE_FILING_DATE_LTE=2026-12-31

# NASA FIRMS (physical_facility_disruption) — free MAP_KEY
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
# FIRMS_MAP_KEY=your_firms_map_key

WEBULL_VISUALIZE=true
WEBULL_VISUALIZE_ENGINE=lwc
# LOG_LEVEL=INFO
