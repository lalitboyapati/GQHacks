# Copy to .env in this directory and fill in. .env is gitignored.

# --- Massive (prices, option chains, option bars, news, market caps) ------
# Required for the backtest. Polygon-compatible; POLYGON_API_KEY also works.
MASSIVE_API_KEY=your_massive_key

# --- Databento (optional: real OPRA quotes for validation) ---------------
# Only needed to re-price the top signals on true bid/ask. Metered by data
# volume, so both caps below are enforced before any query is sent.
DATABENTO_API_KEY=
DATABENTO_BUDGET_USD=225
DATABENTO_RUN_BUDGET_USD=25

# --- Webull (optional: equity bars via the sibling Backtrader starter) ---
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_API_ENDPOINT=api.webull.com
WEBULL_REGION_ID=us

# --- SEC EDGAR -----------------------------------------------------------
# No key needed, but the SEC asks automated clients to identify themselves
# with a real contact address. Set this to "Your Name you@domain.com".
SEC_USER_AGENT=GQHacks Research admin@gqhacks.dev
SEC_REQUESTS_PER_SECOND=6

# Set to 1 to forbid network access and run purely from the local cache.
EIGHTK_OFFLINE=0
