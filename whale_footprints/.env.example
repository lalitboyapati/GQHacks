# Copy to whale_footprints/.env (gitignored): cp .env.example .env. Never commit real keys.
MASSIVE_API_KEY=your_massive_key          # news + options reference/bars (screen, news filter)
DATABENTO_API_KEY=db-your_databento_key   # OPRA tcbbo (whale signing) — metered, capped in config.py
WEBULL_APP_KEY=your_webull_app_key        # backtest price bars only
WEBULL_APP_SECRET=your_webull_app_secret
WEBULL_API_ENDPOINT=api.webull.com        # api.sandbox.webull.com for sandbox keys (bars are served there too)
WEBULL_REGION_ID=us
